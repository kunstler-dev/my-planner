{
  "name": "planner",
  "productName": "Planner",
  "version": "1.12.0",
  "description": "Black-and-white planner: money, job search, Telegram channels, Grok",
  "main": "src/main/main.js",
  "author": "kunstler-dev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.*\"",
    "dist:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "dev.kunstler.planner",
    "productName": "Planner",
    "artifactName": "Planner-${version}-portable.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/three/{examples,src,docs,editor,manual}/**",
      "!node_modules/three/build/{three.cjs,three.module.min.js,three.core.min.js,three.webgpu*,three.tsl*}",
      "!node_modules/pdf-parse/lib/pdf.js/{v1.9.426,v1.10.88,v2.0.550}/**",
      "!node_modules/pdf-parse/test/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "imapflow": "2.4.2",
    "mailparser": "3.9.39",
    "pdf-parse": "1.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  }
}
